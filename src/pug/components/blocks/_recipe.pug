//- Карточка рецепта. Ссылка стоит на названии и растянута на всю карточку стилями:
//- кликабельна вся карточка, а у ссылки осмысленный текст для поисковиков и скринридеров
mixin recipe(recipe)
  article.recipe
    .recipe__wrapper
      .recipe__image
        img(src=`./${seo.recipeImage(recipe, true)}` alt=`Фото рецепта: ${recipe.title}` width="500" height="435" loading="lazy" decoding="async")
        if recipe.place
          p.recipe__badge
            span(aria-hidden="true") ★
            | Победитель
      .recipe__content
        p.recipe__category= recipe.category
        h3.recipe__name
          a.recipe__link(href=`${baseURL}/${seo.recipePath(recipe)}`)= recipe.title
