//- Старые ссылки вида recipe.html#186 разошлись по соцсетям — переводим их на новые страницы рецептов
- var slugs = Object.fromEntries(recipes.map(item => [item.id, item.slug]))
doctype html
html(lang='ru')
  head
    meta(charset="utf-8")
    title Переход к рецепту — #{seo.SITE_NAME}
    meta(name="robots" content="noindex, follow")
    link(rel="canonical" href=`${seo.SITE_URL}/`)
    script.
      (function () {
        var slugs = !{JSON.stringify(slugs)};
        var key = decodeURIComponent(location.hash.slice(1));
        var slug = slugs[key] || (Object.keys(slugs).some(function (id) { return slugs[id] === key; }) ? key : null);
        location.replace(slug ? "recipe-" + slug + ".html" : "./#recipes");
      })();
  body
    p
      a(href=`${baseURL}/#recipes`) Все рецепты Vegan Halloween
